 * @param page Page to return, starting at 1
 * @return The commits, without stats and files
 */
public f<Result<Vector<Commit>>> GitHubClient.listCommits(string owner, string repo, const CommitFilter& filter, long page = 1l) {
    Query query;
    query.add("sha", filter.sha);
    query.add("path", filter.path);
    query.add("author", filter.author);
    query.add("since", filter.since);
    query.add("until", filter.until);
    this.addPage(query, page);
    return this.requestList<Commit>(HttpMethod::GET, repoPath(owner, repo) + "/commits" + query.text, String());
}

/**
 * Lists the commits of the default branch of a repository, newest first
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param page Page to return, starting at 1
 * @return The commits, without stats and files
 */
public f<Result<Vector<Commit>>> GitHubClient.listCommits(string owner, string repo, long page = 1l) {
    const CommitFilter filter;
    return this.listCommits(owner, repo, filter, page);
}

/**
 * Returns a commit, including its stats and changed files
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param ref Sha, branch or tag
 * @return The commit
 */
public f<Result<Commit>> GitHubClient.getCommit(string owner, string repo, string ref) {
    return this.requestObject<Commit>(HttpMethod::GET, repoPath(owner, repo) + "/commits/" + encodePath(ref), String());
}

// ====================================================== Contents =====================================================

/**
 * Returns a file of a repository, including its decoded content
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param path Path of the file
 * @param ref Branch, tag or sha to read from, the default branch if empty
 * @return The file
 */
public f<Result<Content>> GitHubClient.getFile(string owner, string repo, string path, string ref = "") {
    Query query;
    query.add("ref", ref);
    return this.fetchFile(repoPath(owner, repo) + "/contents/" + encodePath(path) + query.text);
}

/**
 * Returns the README of a repository, including its decoded content
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param ref Branch, tag or sha to read from, the default branch if empty
 * @return The README file
 */
public f<Result<Content>> GitHubClient.getReadme(string owner, string repo, string ref = "") {
    Query query;
    query.add("ref", ref);
    return this.fetchFile(repoPath(owner, repo) + "/readme" + query.text);
}

/**
 * Fetches a file through the contents API and decodes its Base64 payload
 */
f<Result<Content>> GitHubClient.fetchFile(const String& path) {
    Result<JsonValue*> json = this.requestJson(HttpMethod::GET, path, String());
    if json.isErr() { return err<Content>(json.getErr()); }
    JsonValue* root = json.unwrap();
    if !root.isObject() {
        // Directories are answered with an array of their entries
        deleteJsonValue(root);
        this.lastError.message = String("The path is a directory, not a file");
        return err<Content>("The path is a directory, not a file");
    }
    Content file;
    file.loadJson(root);
    JsonReader reader = JsonReader(root);
    String encoding;
    String encoded;
    reader.readString("encoding", encoding);
    reader.readString("content", encoded);
    deleteJsonValue(root);
    if encoding == "base64" {
        Result<String> decoded = decodeBase64(stripWhitespace(encoded));
        if decoded.isErr() { return this.failDecoding<Content>(); }
        file.content = decoded.unwrap();
    } else if encoding == "none" {
        // Files above 1 MB come without content and have to be fetched from the download URL
        this.lastError.message = String("The file is too large for the contents API, use its downloadUrl instead");
        return err<Content>("The file is too large for the contents API");
    }
    return ok(file);
}

/**
 * Lists the entries of a directory of a repository
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param path Path of the directory, empty for the root
 * @param ref Branch, tag or sha to read from, the default branch if empty
 * @return The entries, without content
 */
public f<Result<Vector<Content>>> GitHubClient.listDirectory(string owner, string repo, string path = "", string ref = "") {
    Query query;
    query.add("ref", ref);
    const String fullPath = repoPath(owner, repo) + "/contents/" + encodePath(path) + query.text;
    return this.requestList<Content>(HttpMethod::GET, fullPath, String());
}

/**
 * Creates a file, or replaces it if `change.sha` names its current blob, in a new commit
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param path Path of the file
 * @param change Commit message, content and target of the change
 * @return Shas of the new blob and the commit
 */
public f<Result<FileCommit>> GitHubClient.createOrUpdateFile(string owner, string repo, string path, const FileChange& change) {
    JsonBuilder body;
    body.putString("message", change.message);
    body.putString("content", encodeBase64(change.content));
    this.putFileChangeTarget(body, change);
    const String fullPath = repoPath(owner, repo) + "/contents/" + encodePath(path);
    return this.requestObject<FileCommit>(HttpMethod::PUT, fullPath, body.build());
}

/**
 * Deletes a file in a new commit. `change.sha` has to name the current blob of the file
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param path Path of the file
 * @param change Commit message, blob sha and target of the change
 * @return Sha of the commit
 */
public f<Result<FileCommit>> GitHubClient.deleteFile(string owner, string repo, string path, const FileChange& change) {
    JsonBuilder body;
    body.putString("message", change.message);
    this.putFileChangeTarget(body, change);
    const String fullPath = repoPath(owner, repo) + "/contents/" + encodePath(path);
    return this.requestObject<FileCommit>(HttpMethod::DELETE, fullPath, body.build());
}

p GitHubClient.putFileChangeTarget(JsonBuilder& body, const FileChange& change) {
    body.putStringIfSet("sha", change.sha);
    body.putStringIfSet("branch", change.branch);
    if !change.committerName.isEmpty() && !change.committerEmail.isEmpty() {
        body.putPerson("committer", change.committerName, change.committerEmail);
    }
}

// ======================================================= Issues ======================================================

/**
 * Lists the issues of a repository. Pull requests are included as well, see `Issue.isPullRequest`
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param filter State, labels, people and sort order
 * @param page Page to return, starting at 1
 * @return The issues
 */
public f<Result<Vector<Issue>>> GitHubClient.listIssues(string owner, string repo, const IssueFilter& filter, long page = 1l) {
    Query query;
    query.add("state", filter.state);
    query.add("labels", filter.labels);
    query.add("assignee", filter.assignee);
    query.add("creator", filter.creator);
    query.add("mentioned", filter.mentioned);
    query.add("milestone", filter.milestone);
    query.add("sort", filter.sort);
    query.add("direction", filter.direction);
    query.add("since", filter.since);
    this.addPage(query, page);
    return this.requestList<Issue>(HttpMethod::GET, repoPath(owner, repo) + "/issues" + query.text, String());
}

/**
 * Lists the open issues of a repository. Pull requests are included as well, see `Issue.isPullRequest`
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param page Page to return, starting at 1
 * @return The issues
 */
public f<Result<Vector<Issue>>> GitHubClient.listIssues(string owner, string repo, long page = 1l) {
    const IssueFilter filter;
    return this.listIssues(owner, repo, filter, page);
}

/**
 * Returns an issue
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the issue
 * @return The issue
 */
public f<Result<Issue>> GitHubClient.getIssue(string owner, string repo, long number) {
    return this.requestObject<Issue>(HttpMethod::GET, issuePath(owner, repo, number), String());
}

/**
 * Opens an issue
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param issue Title and further fields of the issue
 * @return The new issue
 */
public f<Result<Issue>> GitHubClient.createIssue(string owner, string repo, const IssueChange& issue) {
    JsonBuilder body;
    body.putString("title", issue.title);
    putIssueFields(body, issue);
    return this.requestObject<Issue>(HttpMethod::POST, repoPath(owner, repo) + "/issues", body.build());
}

/**
 * Opens an issue with the given title and body
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param title Title of the issue
 * @param text Body of the issue, in Markdown
 * @return The new issue
 */
public f<Result<Issue>> GitHubClient.createIssue(string owner, string repo, string title, string text = "") {
    IssueChange issue;
    issue.title = String(title);
    issue.body = String(text);
    return this.createIssue(owner, repo, issue);
}

/**
 * Updates an issue. Only the fields that are set in the change are modified
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the issue
 * @param change Fields to update
 * @return The updated issue
 */
public f<Result<Issue>> GitHubClient.updateIssue(string owner, string repo, long number, const IssueChange& change) {
    JsonBuilder body;
    body.putStringIfSet("title", change.title);
    body.putStringIfSet("state", change.state);
    body.putStringIfSet("state_reason", change.stateReason);
    putIssueFields(body, change);
    return this.requestObject<Issue>(HttpMethod::PATCH, issuePath(owner, repo, number), body.build());
}

/**
 * Closes an issue
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the issue
 * @param reason "completed" or "not_planned"
 * @return The closed issue
 */
public f<Result<Issue>> GitHubClient.closeIssue(string owner, string repo, long number, string reason = "completed") {
    IssueChange change;
    change.state = String("closed");
    change.stateReason = String(reason);
    return this.updateIssue(owner, repo, number, change);
}

/**
 * Reopens an issue
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the issue
 * @return The reopened issue
 */
public f<Result<Issue>> GitHubClient.reopenIssue(string owner, string repo, long number) {
    IssueChange change;
    change.state = String("open");
    return this.updateIssue(owner, repo, number, change);
}

/**
 * Lists the comments on an issue or on the conversation of a pull request, oldest first
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the issue or pull request
 * @param page Page to return, starting at 1
 * @return The comments
 */
public f<Result<Vector<Comment>>> GitHubClient.listComments(string owner, string repo, long number, long page = 1l) {
    Query query;
    this.addPage(query, page);
    return this.requestList<Comment>(HttpMethod::GET, issuePath(owner, repo, number) + "/comments" + query.text, String());
}

/**
 * Comments on an issue or on the conversation of a pull request
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the issue or pull request
 * @param text Comment, in Markdown
 * @return The new comment
 */
public f<Result<Comment>> GitHubClient.createComment(string owner, string repo, long number, string text) {
    JsonBuilder body;
    body.putString("body", String(text));
    return this.requestObject<Comment>(HttpMethod::POST, issuePath(owner, repo, number) + "/comments", body.build());
}

/**
 * Replaces the text of a comment
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param commentId Id of the comment
 * @param text New comment, in Markdown
 * @return The updated comment
 */
public f<Result<Comment>> GitHubClient.updateComment(string owner, string repo, long commentId, string text) {
    JsonBuilder body;
    body.putString("body", String(text));
    return this.requestObject<Comment>(HttpMethod::PATCH, commentPath(owner, repo, commentId), body.build());
}

/**
 * Deletes a comment
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param commentId Id of the comment
 * @return true on success
 */
public f<Result<bool>> GitHubClient.deleteComment(string owner, string repo, long commentId) {
    return this.requestNoContent(HttpMethod::DELETE, commentPath(owner, repo, commentId), String());
}

/**
 * Lists the labels defined in a repository
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param page Page to return, starting at 1
 * @return The labels
 */
public f<Result<Vector<Label>>> GitHubClient.listLabels(string owner, string repo, long page = 1l) {
    Query query;
    this.addPage(query, page);
    return this.requestList<Label>(HttpMethod::GET, repoPath(owner, repo) + "/labels" + query.text, String());
}

/**
 * Defines a new label in a repository
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param name Name of the label
 * @param color Hex color without the leading '#', e.g. "d73a4a"
 * @param description Short description
 * @return The new label
 */
public f<Result<Label>> GitHubClient.createLabel(string owner, string repo, string name, string color, string description = "") {
    JsonBuilder body;
    body.putString("name", String(name));
    body.putString("color", String(color));
    body.putStringIfSet("description", String(description));
    return this.requestObject<Label>(HttpMethod::POST, repoPath(owner, repo) + "/labels", body.build());
}

/**
 * Adds labels to an issue or pull request. Labels that do not exist yet are created
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the issue or pull request
 * @param labels Names of the labels
 * @return All labels of the issue afterwards
 */
public f<Result<Vector<Label>>> GitHubClient.addLabels(string owner, string repo, long number, const Vector<String>& labels) {
    JsonBuilder body;
    body.putStringArray("labels", labels);
    return this.requestList<Label>(HttpMethod::POST, issuePath(owner, repo, number) + "/labels", body.build());
}

/**
 * Removes a label from an issue or pull request
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the issue or pull request
 * @param label Name of the label
 * @return The remaining labels of the issue
 */
public f<Result<Vector<Label>>> GitHubClient.removeLabel(string owner, string repo, long number, string label) {
    const String path = issuePath(owner, repo, number) + "/labels/" + urlEncode(String(label));
    return this.requestList<Label>(HttpMethod::DELETE, path, String());
}

f<String> issuePath(string owner, string repo, long number) {
    return repoPath(owner, repo) + "/issues/" + toString(number);
}

f<String> commentPath(string owner, string repo, long commentId) {
    return repoPath(owner, repo) + "/issues/comments/" + toString(commentId);
}

/**
 * Adds the fields that creating and updating an issue have in common
 */
p putIssueFields(JsonBuilder& body, const IssueChange& issue) {
    body.putStringIfSet("body", issue.body);
    if !issue.labels.isEmpty() { body.putStringArray("labels", issue.labels); }
    if !issue.assignees.isEmpty() { body.putStringArray("assignees", issue.assignees); }
    if issue.milestone > 0l { body.putLong("milestone", issue.milestone); }
}

// ==================================================== Pull requests ==================================================

/**
 * Lists the pull requests of a repository
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param filter State, branches and sort order
 * @param page Page to return, starting at 1
 * @return The pull requests, without counts and mergeability
 */
public f<Result<Vector<PullRequest>>> GitHubClient.listPullRequests(string owner, string repo, const PullRequestFilter& filter, long page = 1l) {
    Query query;
    query.add("state", filter.state);
    query.add("head", filter.head);
    query.add("base", filter.base);
    query.add("sort", filter.sort);
    query.add("direction", filter.direction);
    this.addPage(query, page);
    return this.requestList<PullRequest>(HttpMethod::GET, repoPath(owner, repo) + "/pulls" + query.text, String());
}

/**
 * Lists the open pull requests of a repository
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param page Page to return, starting at 1
 * @return The pull requests, without counts and mergeability
 */
public f<Result<Vector<PullRequest>>> GitHubClient.listPullRequests(string owner, string repo, long page = 1l) {
    const PullRequestFilter filter;
    return this.listPullRequests(owner, repo, filter, page);
}

/**
 * Returns a pull request
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @return The pull request
 */
public f<Result<PullRequest>> GitHubClient.getPullRequest(string owner, string repo, long number) {
    return this.requestObject<PullRequest>(HttpMethod::GET, pullPath(owner, repo, number), String());
}

/**
 * Opens a pull request
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param settings Title, branches and further settings
 * @return The new pull request
 */
public f<Result<PullRequest>> GitHubClient.createPullRequest(string owner, string repo, const NewPullRequest& settings) {
    JsonBuilder body;
    body.putString("title", settings.title);
    body.putString("head", settings.head);
    body.putString("base", settings.base);
    body.putStringIfSet("body", settings.body);
    body.putBool("draft", settings.isDraft);
    body.putBool("maintainer_can_modify", settings.maintainerCanModify);
    return this.requestObject<PullRequest>(HttpMethod::POST, repoPath(owner, repo) + "/pulls", body.build());
}

/**
 * Updates a pull request. Only the fields that are set in the change are modified
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @param change Fields to update
 * @return The updated pull request
 */
public f<Result<PullRequest>> GitHubClient.updatePullRequest(string owner, string repo, long number, const PullRequestChange& change) {
    JsonBuilder body;
    body.putStringIfSet("title", change.title);
    body.putStringIfSet("body", change.body);
    body.putStringIfSet("state", change.state);
    body.putStringIfSet("base", change.base);
    return this.requestObject<PullRequest>(HttpMethod::PATCH, pullPath(owner, repo, number), body.build());
}

/**
 * Merges a pull request
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @param options Merge method and commit message
 * @return Outcome of the merge. GitHub answers 405 if the pull request cannot be merged and 409 if the head moved
 */
public f<Result<MergeResult>> GitHubClient.mergePullRequest(string owner, string repo, long number, const MergeOptions& options) {
    JsonBuilder body;
    body.putStringIfSet("merge_method", options.method);
    body.putStringIfSet("commit_title", options.commitTitle);
    body.putStringIfSet("commit_message", options.commitMessage);
    body.putStringIfSet("sha", options.sha);
    return this.requestObject<MergeResult>(HttpMethod::PUT, pullPath(owner, repo, number) + "/merge", body.build());
}

/**
 * Merges a pull request with the given method and the default commit message
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @param method "merge", "squash" or "rebase"
 * @return Outcome of the merge
 */
public f<Result<MergeResult>> GitHubClient.mergePullRequest(string owner, string repo, long number, string method = "merge") {
    MergeOptions options;
    options.method = String(method);
    return this.mergePullRequest(owner, repo, number, options);
}

/**
 * Lists the files a pull request changes
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @param page Page to return, starting at 1
 * @return The changed files
 */
public f<Result<Vector<ChangedFile>>> GitHubClient.listPullRequestFiles(string owner, string repo, long number, long page = 1l) {
    Query query;
    this.addPage(query, page);
    return this.requestList<ChangedFile>(HttpMethod::GET, pullPath(owner, repo, number) + "/files" + query.text, String());
}

/**
 * Lists the commits of a pull request
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @param page Page to return, starting at 1
 * @return The commits, without stats and files
 */
public f<Result<Vector<Commit>>> GitHubClient.listPullRequestCommits(string owner, string repo, long number, long page = 1l) {
    Query query;
    this.addPage(query, page);
    return this.requestList<Commit>(HttpMethod::GET, pullPath(owner, repo, number) + "/commits" + query.text, String());
}

/**
 * Lists the reviews of a pull request
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @param page Page to return, starting at 1
 * @return The reviews
 */
public f<Result<Vector<Review>>> GitHubClient.listReviews(string owner, string repo, long number, long page = 1l) {
    Query query;
    this.addPage(query, page);
    return this.requestList<Review>(HttpMethod::GET, pullPath(owner, repo, number) + "/reviews" + query.text, String());
}

/**
 * Submits a review of a pull request
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @param event "APPROVE", "REQUEST_CHANGES" or "COMMENT"
 * @param text Review comment, in Markdown. Required for REQUEST_CHANGES and COMMENT
 * @return The review
 */
public f<Result<Review>> GitHubClient.createReview(string owner, string repo, long number, string event, string text = "") {
    JsonBuilder body;
    body.putString("event", String(event));
    body.putStringIfSet("body", String(text));
    return this.requestObject<Review>(HttpMethod::POST, pullPath(owner, repo, number) + "/reviews", body.build());
}

/**
 * Requests reviews of a pull request from users
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param number Number of the pull request
 * @param reviewers Logins of the reviewers
 * @return The updated pull request
 */
public f<Result<PullRequest>> GitHubClient.requestReviewers(string owner, string repo, long number, const Vector<String>& reviewers) {
    JsonBuilder body;
    body.putStringArray("reviewers", reviewers);
    return this.requestObject<PullRequest>(HttpMethod::POST, pullPath(owner, repo, number) + "/requested_reviewers", body.build());
}

f<String> pullPath(string owner, string repo, long number) {
    return repoPath(owner, repo) + "/pulls/" + toString(number);
}

// ====================================================== Releases =====================================================

/**
 * Lists the releases of a repository, newest first. Drafts are only included for users with push access
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param page Page to return, starting at 1
 * @return The releases
 */
public f<Result<Vector<Release>>> GitHubClient.listReleases(string owner, string repo, long page = 1l) {
    Query query;
    this.addPage(query, page);
    return this.requestList<Release>(HttpMethod::GET, repoPath(owner, repo) + "/releases" + query.text, String());
}

/**
 * Returns a release
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param releaseId Id of the release
 * @return The release
 */
public f<Result<Release>> GitHubClient.getRelease(string owner, string repo, long releaseId) {
    return this.requestObject<Release>(HttpMethod::GET, releasePath(owner, repo, releaseId), String());
}

/**
 * Returns the latest published full release, i.e. the newest one that is neither a draft nor a prerelease
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @return The release, or a 404 error if there is none
 */
public f<Result<Release>> GitHubClient.getLatestRelease(string owner, string repo) {
    return this.requestObject<Release>(HttpMethod::GET, repoPath(owner, repo) + "/releases/latest", String());
}

/**
 * Returns the release of a tag
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param tag Name of the tag
 * @return The release
 */
public f<Result<Release>> GitHubClient.getReleaseByTag(string owner, string repo, string tag) {
    return this.requestObject<Release>(HttpMethod::GET, repoPath(owner, repo) + "/releases/tags/" + encodePath(tag), String());
}

/**
 * Creates a release. The tag is created as well, if it does not exist yet
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param settings Tag, name, notes and flags of the release
 * @return The new release
 */
public f<Result<Release>> GitHubClient.createRelease(string owner, string repo, const NewRelease& settings) {
    JsonBuilder body;
    body.putString("tag_name", settings.tagName);
    body.putStringIfSet("target_commitish", settings.targetCommitish);
    body.putStringIfSet("name", settings.name);
    body.putStringIfSet("body", settings.body);
    body.putBool("draft", settings.isDraft);
    body.putBool("prerelease", settings.isPrerelease);
    body.putBool("generate_release_notes", settings.generateReleaseNotes);
    return this.requestObject<Release>(HttpMethod::POST, repoPath(owner, repo) + "/releases", body.build());
}

/**
 * Deletes a release. The tag stays
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param releaseId Id of the release
 * @return true on success
 */
public f<Result<bool>> GitHubClient.deleteRelease(string owner, string repo, long releaseId) {
    return this.requestNoContent(HttpMethod::DELETE, releasePath(owner, repo, releaseId), String());
}

f<String> releasePath(string owner, string repo, long releaseId) {
    return repoPath(owner, repo) + "/releases/" + toString(releaseId);
}

// ====================================================== Actions ======================================================

/**
 * Lists the GitHub Actions workflows of a repository
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param page Page to return, starting at 1
 * @return The workflows and their total count
 */
public f<Result<CountedList<Workflow>>> GitHubClient.listWorkflows(string owner, string repo, long page = 1l) {
    Query query;
    this.addPage(query, page);
    Result<JsonValue*> json = this.requestJson(HttpMethod::GET, repoPath(owner, repo) + "/actions/workflows" + query.text, String());
    if json.isErr() { return err<CountedList<Workflow>>(json.getErr()); }
    JsonValue* root = json.unwrap();
    CountedList<Workflow> workflows;
    workflows.loadJson(root, "workflows");
    deleteJsonValue(root);
    return ok(workflows);
}

/**
 * Lists workflow runs of a repository, newest first
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param filter Workflow, branch, event, status and actor to list runs of
 * @param page Page to return, starting at 1
 * @return The runs and their total count
 */
public f<Result<CountedList<WorkflowRun>>> GitHubClient.listWorkflowRuns(string owner, string repo, const WorkflowRunFilter& filter, long page = 1l) {
    Query query;
    query.add("branch", filter.branch);
    query.add("event", filter.event);
    query.add("status", filter.status);
    query.add("actor", filter.actor);
    this.addPage(query, page);
    String path = repoPath(owner, repo) + "/actions";
    if !filter.workflow.isEmpty() { path += String("/workflows/") + urlEncode(filter.workflow); }
    path += "/runs";
    path += query.text;
    Result<JsonValue*> json = this.requestJson(HttpMethod::GET, path, String());
    if json.isErr() { return err<CountedList<WorkflowRun>>(json.getErr()); }
    JsonValue* root = json.unwrap();
    CountedList<WorkflowRun> runs;
    runs.loadJson(root, "workflow_runs");
    deleteJsonValue(root);
    return ok(runs);
}

/**
 * Lists the workflow runs of a repository, newest first
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param page Page to return, starting at 1
 * @return The runs and their total count
 */
public f<Result<CountedList<WorkflowRun>>> GitHubClient.listWorkflowRuns(string owner, string repo, long page = 1l) {
    const WorkflowRunFilter filter;
    return this.listWorkflowRuns(owner, repo, filter, page);
}

/**
 * Returns a workflow run
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param runId Id of the run
 * @return The run
 */
public f<Result<WorkflowRun>> GitHubClient.getWorkflowRun(string owner, string repo, long runId) {
    return this.requestObject<WorkflowRun>(HttpMethod::GET, runPath(owner, repo, runId), String());
}

/**
 * Triggers a workflow that declares the workflow_dispatch event
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param workflow Workflow id or file name, e.g. "release.yml"
 * @param dispatch Ref and inputs to run the workflow with
 * @return true once GitHub accepted the trigger. The run itself starts asynchronously
 */
public f<Result<bool>> GitHubClient.dispatchWorkflow(string owner, string repo, string workflow, const WorkflowDispatch& dispatch) {
    JsonBuilder body;
    body.putString("ref", dispatch.ref);
    if !dispatch.inputNames.isEmpty() { body.putStringMap("inputs", dispatch.inputNames, dispatch.inputValues); }
    const String path = repoPath(owner, repo) + "/actions/workflows/" + urlEncode(String(workflow)) + "/dispatches";
    return this.requestNoContent(HttpMethod::POST, path, body.build());
}

/**
 * Cancels a workflow run
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param runId Id of the run
 * @return true once GitHub accepted the cancellation
 */
public f<Result<bool>> GitHubClient.cancelWorkflowRun(string owner, string repo, long runId) {
    return this.requestNoContent(HttpMethod::POST, runPath(owner, repo, runId) + "/cancel", String());
}

/**
 * Re-runs a workflow run
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param runId Id of the run
 * @param onlyFailedJobs Only re-run the jobs that failed
 * @return true once GitHub accepted the re-run
 */
public f<Result<bool>> GitHubClient.rerunWorkflowRun(string owner, string repo, long runId, bool onlyFailedJobs = false) {
    const String path = runPath(owner, repo, runId) + (onlyFailedJobs ? "/rerun-failed-jobs" : "/rerun");
    return this.requestNoContent(HttpMethod::POST, path, String());
}

f<String> runPath(string owner, string repo, long runId) {
    return repoPath(owner, repo) + "/actions/runs/" + toString(runId);
}

// ======================================================= Search ======================================================

/**
 * Searches repositories
 *
 * @param query Search query, e.g. "language:spice stars:>10"
 * @param options Sort order
 * @param page Page to return, starting at 1
 * @return The matching repositories and their total count
 */
public f<Result<SearchResult<Repository>>> GitHubClient.searchRepositories(string query, const SearchOptions& options, long page = 1l) {
    SearchResult<Repository> found;
    Result<bool> loaded = this.requestInto<SearchResult<Repository>>(HttpMethod::GET, this.searchPath("repositories", query, options, page), String(), found);
    if loaded.isErr() { return err<SearchResult<Repository>>(loaded.getErr()); }
    return ok(found);
}

/**
 * Searches repositories, best match first
 *
 * @param query Search query, e.g. "language:spice stars:>10"
 * @param page Page to return, starting at 1
 * @return The matching repositories and their total count
 */
public f<Result<SearchResult<Repository>>> GitHubClient.searchRepositories(string query, long page = 1l) {
    const SearchOptions options;
    return this.searchRepositories(query, options, page);
}

/**
 * Searches issues and pull requests
 *
 * @param query Search query, e.g. "repo:spicelang/spice is:issue is:open label:bug"
 * @param options Sort order
 * @param page Page to return, starting at 1
 * @return The matching issues and their total count
 */
public f<Result<SearchResult<Issue>>> GitHubClient.searchIssues(string query, const SearchOptions& options, long page = 1l) {
    SearchResult<Issue> found;
    Result<bool> loaded = this.requestInto<SearchResult<Issue>>(HttpMethod::GET, this.searchPath("issues", query, options, page), String(), found);
    if loaded.isErr() { return err<SearchResult<Issue>>(loaded.getErr()); }
    return ok(found);
}

/**
 * Searches issues and pull requests, best match first
 *
 * @param query Search query, e.g. "repo:spicelang/spice is:issue is:open label:bug"
 * @param page Page to return, starting at 1
 * @return The matching issues and their total count
 */
public f<Result<SearchResult<Issue>>> GitHubClient.searchIssues(string query, long page = 1l) {
    const SearchOptions options;
    return this.searchIssues(query, options, page);
}

/**
 * Searches users and organizations
 *
 * @param query Search query, e.g. "location:germany language:spice"
 * @param options Sort order
 * @param page Page to return, starting at 1
 * @return The matching users and their total count. Only the basic fields of the users are filled
 */
public f<Result<SearchResult<User>>> GitHubClient.searchUsers(string query, const SearchOptions& options, long page = 1l) {
    SearchResult<User> found;
    Result<bool> loaded = this.requestInto<SearchResult<User>>(HttpMethod::GET, this.searchPath("users", query, options, page), String(), found);
    if loaded.isErr() { return err<SearchResult<User>>(loaded.getErr()); }
    return ok(found);
}

/**
 * Searches users and organizations, best match first
 *
 * @param query Search query, e.g. "location:germany language:spice"
 * @param page Page to return, starting at 1
 * @return The matching users and their total count. Only the basic fields of the users are filled
 */
public f<Result<SearchResult<User>>> GitHubClient.searchUsers(string query, long page = 1l) {
    const SearchOptions options;
    return this.searchUsers(query, options, page);
}

f<String> GitHubClient.searchPath(string kind, string text, const SearchOptions& options, long page) {
    Query query;
    query.add("q", text);
    query.add("sort", options.sort);
    query.add("order", options.order);
    this.addPage(query, page);
    return String("/search/") + kind + query.text;
}

// ======================================================== Tests ======================================================

#[test]
f<bool> testPageLinks() {
    const String header = String("<https://api.github.com/repositories/1/issues?state=all&page=3>; rel=\"next\", ") +
                          "<https://api.github.com/repositories/1/issues?state=all&page=7>; rel=\"last\", " +
                          "<https://api.github.com/repositories/1/issues?page=1&state=all>; rel=\"first\"";
    const PageLinks links = parsePageLinks(header);
    assert links.next == 3l;
    assert links.last == 7l;
    assert links.first == 1l;
    assert links.prev == 0l;
    assert links.hasNext();
    const PageLinks none = parsePageLinks(String(""));
    assert !none.hasNext();
    return true;
}

#[test]
f<bool> testPaths() {
    assert repoPath("spicelang", "spice") == "/repos/spicelang/spice";
    assert repoPath("a b", "c/d") == "/repos/a%20b/c%2Fd";
    assert encodePath("docs/my file.md") == "docs/my%20file.md";
    assert issuePath("o", "r", 42l) == "/repos/o/r/issues/42";
    Query query;
    query.add("q", "language:spice stars:>10");
    query.add("sort", "");
    query.addLong("page", 2l);
    query.addLong("per_page", 0l);
    assert query.text == "?q=language%3Aspice%20stars%3A%3E10&page=2";
    return true;
}

#[test]
f<bool> testFilePayload() {
    assert stripWhitespace(String("SGVsbG8s\nIFNwaWNlIQo=\n")) == "SGVsbG8sIFNwaWNlIQo=";
    const Result<String> decoded = decodeBase64(stripWhitespace(String("SGVsbG8s\r\nIFNwaWNlIQo=\n")));
    assert decoded.isOk();
    assert decoded.unwrap() == "Hello, Spice!\n";
    assert encodeBase64(String("Hello, Spice!\n")) == "SGVsbG8sIFNwaWNlIQo=";
    const Result<String> invalid = decodeBase64(stripWhitespace(String("Zm9v!")));
    assert invalid.isErr();
    return true;
}

#[test]
f<bool> testErrorDescription() {
    GitHubError error;
    error.status = 422s;
    error.message = String("Validation Failed");
    error.details.pushBack(String("title: missing_field"));
    error.details.pushBack(String("Label does not exist"));
    assert error.describe() == "422 Validation Failed (title: missing_field, Label does not exist)";
    error.clear();
    assert error.describe() == "";
    return true;
}
