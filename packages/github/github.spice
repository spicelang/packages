    const String path = String("/user/starred/") + urlEncode(String(owner)) + "/" + urlEncode(String(repo));
    return this.requestNoContent(HttpMethod::PUT, path, String());
}

/**
 * Removes the star of the authenticated user from a repository
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @return true on success
 */
public f<Result<bool>> GitHubClient.unstarRepository(string owner, string repo) {
    const String path = String("/user/starred/") + urlEncode(String(owner)) + "/" + urlEncode(String(repo));
    return this.requestNoContent(HttpMethod::DELETE, path, String());
}

/**
 * Lists the topics of a repository
