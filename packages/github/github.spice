/**
 * Creates a repository for the authenticated user, or for an organization
 *
 * @param settings Settings of the repository
 * @param org Organization to create the repository in, empty for the authenticated user
 * @return The new repository
 */
public f<Result<Repository>> GitHubClient.createRepository(const NewRepository& settings, string org = "") {
    JsonBuilder body;
    body.putString("name", settings.name);
    body.putStringIfSet("description", settings.description);
    body.putStringIfSet("homepage", settings.homepage);
    body.putBool("private", settings.isPrivate);
    body.putBool("auto_init", settings.autoInit);
    body.putStringIfSet("gitignore_template", settings.gitignoreTemplate);
    body.putStringIfSet("license_template", settings.licenseTemplate);
    const String orgName = String(org);
    const String path = orgName.isEmpty() ? String("/user/repos") : String("/orgs/") + urlEncode(orgName) + "/repos";
    return this.requestObject<Repository>(HttpMethod::POST, path, body.build());
}

/**
 * Deletes a repository. Requires the delete_repo scope
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @return true on success
 */
public f<Result<bool>> GitHubClient.deleteRepository(string owner, string repo) {
    return this.requestNoContent(HttpMethod::DELETE, repoPath(owner, repo), String());
}

/**
 * Forks a repository into the account of the authenticated user, or into an organization. GitHub creates the fork
 * asynchronously, so its contents may take a moment to show up
 *
 * @param owner Owner of the repository
 * @param repo Name of the repository
 * @param org Organization to fork into, empty for the authenticated user
 * @return The fork
 */
public f<Result<Repository>> GitHubClient.forkRepository(string owner, string repo, string org = "") {
    JsonBuilder body;
    body.putStringIfSet("organization", String(org));
    return this.requestObject<Repository>(HttpMethod::POST, repoPath(owner, repo) + "/forks", body.build());
}

